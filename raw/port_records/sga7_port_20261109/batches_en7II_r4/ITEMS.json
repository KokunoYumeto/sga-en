  "cur": 888,
  "file": "expose_XVIII_body.tex",
  "page": 291,
  "kind": "formula",
  "old": "\\begin{equation}\\tag{5.6.2.1}\nE_2^{0,q} \\; (=H^{0}(\\mathbb{P}^1,R^q\\rho_*\\mathbb{Q}_\\ell)) \\quad \\simeq \\quad H^q(X_{\\overline{\\eta}},\\mathbb{Q}_\\ell)\n\\end{equation}\n\\begin{equation}\\tag{5.6.2.2}\nE_2^{2,q}(=H^2(\\mathbb{P}^1,R^q\\rho_*\\mathbb{Q}_\\ell)) \\quad \\simeq \\quad H^q(X_{\\overline{\\eta}},\\mathbb{Q}_\\ell(-1))\n\\end{equation}\n\\begin{equation}\\tag{5.6.2.3}\nE_2^{p,q}(=H^p(\\mathbb{P}^1,R^q\\rho_*\\mathbb{Q}_\\ell)) \\;=\\; 0,\\; p \\neq 0,2 \\qquad .\n\\end{equation}",
