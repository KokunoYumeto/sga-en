  "new": "\\begin{align}\n&E_2^{0,q} \\; (=H^{0}(\\mathbb{P}^1,R^q\\rho_*\\mathbb{Q}_\\ell)) \\quad \\simeq \\quad H^q(X_{\\overline{\\eta}},\\mathbb{Q}_\\ell) \\tag{5.6.2.1}\\\\\n\\smash{\\left\\{\\rule[-5ex]{0pt}{10ex}\\right.}\\;&E_2^{2,q}(=H^2(\\mathbb{P}^1,R^q\\rho_*\\mathbb{Q}_\\ell)) \\quad \\simeq \\quad H^q(X_{\\overline{\\eta}},\\mathbb{Q}_\\ell(-1)) \\tag{5.6.2.2}\\\\\n&E_2^{p,q}(=H^p(\\mathbb{P}^1,R^q\\rho_*\\mathbb{Q}_\\ell)) \\;=\\; 0,\\; p \\neq 0,2 \\qquad . \\tag{5.6.2.3}\n\\end{align}"
 },
