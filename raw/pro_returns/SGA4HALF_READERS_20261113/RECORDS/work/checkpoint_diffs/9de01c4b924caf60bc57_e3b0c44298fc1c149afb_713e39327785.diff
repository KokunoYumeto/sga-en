-\begin{equation*}\tag{7.15.2}\label{VI:eq:7-15-2}
-  \det\left(F,\h_c^{n-1}(V_a^{n-1},\sF(\psi))\right) = q^{\frac{n(n-1)}{2}} \text{.} 
