-\begin{align*}
-  L(X_0,\sK_0) 
-    &=_\text{\ref{III:2-9}} \det\left(1-F^* T,\Gamma(X,\sK)\right)^{-1} \\
-    &=_\text{\ref{III:1-8}} \var[FR-0075]{\sum_n (\tr\left(F^*,\Gamma^n \Gamma(X,\sK)\right) T^n}{\sum_n \tr\left(F^*,\Gamma^n \Gamma(X,\sK)\right) T^n}{S45-SOL-0480} \\
-    &=_\text{\ref{III:1-3}} \sum_n \var[FR-0076]{\tr\left(F^*,\Gamma(\operatorname{Sym}^n(X),\Gamma_\text{ext}^n(\sK)\right)}{\tr\left(F^*,\Gamma(\operatorname{Sym}^n(X),\Gamma_\text{ext}^n(\sK))\right)}{S45-SOL-0481} T^n \\
-    &= \sum_n \sum_{x\in \operatorname{Sym}^n(X)^F} \tr\left(F_x^*,\Gamma_\text{ext}^n(\sK)\right) T^n
