-\begin{theoremdotdash}[pureté relative]\label{I:5-3-4}
-Soit un diagramme commutatif 
-\begingroup
-\makeatletter
-\tagsleft@true
-\let\veqno\@@leqno
-\makeatother
-\PrintPage{64}\begin{equation*}\tag{3.4.1}\label{I:eq:5-3-4-1}\xymatrix{
-  U \ar@{^{(}->}[r]^-j \ar[dr]
-    & X \ar[d]^-f 
-    & \ar@{_{(}->}[l]_-i Y \ar[dl]^-h \\
-  & S
-}\end{equation*}
