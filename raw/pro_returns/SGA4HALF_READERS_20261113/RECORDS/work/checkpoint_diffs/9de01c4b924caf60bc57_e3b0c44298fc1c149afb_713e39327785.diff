-\end{equation*}
-plus souvent écrit sous la forme 
-\begin{align*}
-  \chi_0(-1) J(\chi) &= (-1)^{N-1} \sum_{\substack{x_1,\dots,x_N\in \dF_q^\ast \\ \sum x_i = 1}} \prod_{i=1}^N \chi_i^{-1}(x_i) = \tau(\chi_0^{-1},\psi)^{-1} \prod_{i=1}^N \tau(\chi_i,\psi) \\
-  \chi_0^{-1} &= \prod_{i=1}^N \chi_i 
-\end{align*}
