+def pages_in(value):
+    result = []
+    for token in re.split(r'[,;]', str(value)):
+        token = token.strip()
+        if token in PAGE_RANK:
+            result.append(token)
+        elif (m := re.fullmatch(r'(\d+)\s*[–—-]\s*(\d+)', token)):
+            result.extend(str(n) for n in range(int(m[1]), int(m[2]) + 1)
+                          if str(n) in PAGE_RANK)
+    return list(dict.fromkeys(result))
+
