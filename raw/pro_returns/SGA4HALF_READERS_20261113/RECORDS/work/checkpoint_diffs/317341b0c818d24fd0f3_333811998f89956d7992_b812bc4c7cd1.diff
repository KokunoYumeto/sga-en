+def mask(s):
+    """Blank text without changing source offsets or line numbers."""
+    return ''.join('\n' if ch == '\n' else ' ' for ch in s)
+
+
+def mask_ranges(s, ranges):
+    chars = list(s)
+    for start, end in ranges:
+        chars[start:end] = mask(s[start:end])
+    return ''.join(chars)
+
