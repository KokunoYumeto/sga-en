+                old = self.baseline_regions(language, baseline)
+                for key in ['main_scaffold', 'preamble', 'style', 'frontmatter',
+                            'typesetter_note', 'general_contents', 'apparatus']:
+                    before_file = old['main_file']
+                    if key == 'style':
