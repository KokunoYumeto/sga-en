+                    references[ident].append({
+                        'id': row['id'], 'register': collection,
+                        'page': str(row.get('printed_page', row.get('page', ''))),
+                        'kind': row.get('kind', ''), 'reason': row.get('reason', ''),
+                        'decision': row.get('change_made', row.get('change', '')),
+                    })
