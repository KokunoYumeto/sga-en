  "\\(K\\)",
  "\\(A\\otimes_{\\mathbb Z}\\mathbb Q\\)",
  "\\(1+\\widehat A^+\\xrightarrow{\\ \\ch\\ }\\widehat A_{\\mathbb Q}^{+}\\)",
  "\\(1+X\\)",
  "\\begin{equation}\\tag{6.3.1}\n  \\ch(1+X)=\\exp(X)-1.\n\\end{equation}",
  "\\(1+\\widehat A^+\\)",
  "\\(1+X,1+Y\\)",
  "\\(1+\\widehat{K[X,Y]}{}^{+}\\)",
  "\\[\n\\begin{aligned}\n \\ch\\bigl((1+X)*(1+Y)\\bigr)\n &= \\ch\\!\\left(\\frac{1+X+Y}{(1+X)(1+Y)}\\right)\\\\\n &= \\ch(1+X+Y)-\\ch(1+X)-\\ch(1+Y)\\\\\n &= \\exp(X+Y)-\\exp(X)-\\exp(Y)+1\\\\\n &= \\ch(1+X).\\ch(1+Y).\n\\end{aligned}\n\\]",
  "\\(\\eta\\)",
  "\\(A\\)",
  "\\(\\widehat A_{\\mathbb Q}^{+}\\)",
  "\\[\n \\eta\\!\\left(\\sum_{k\\ge1} a_k t^k\\right)\n =\n \\sum_{k\\ge1}\\frac{(-1)^{k-1}}{(k-1)!}.a_k t^k.\n\\]",
  "\\(\\forall\\varphi\\in1+\\widehat A^+\\)",
  "\\begin{equation}\\tag{6.3.2}\n  \\ch(\\varphi)=\\eta(\\Log\\varphi).\n\\end{equation}",
  "\\(\\ch\\)",
  "\\(\\eta\\circ\\Log\\)",
